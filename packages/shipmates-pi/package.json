{
	"name": "@shipmates/pi",
	"version": "0.6.0",
	"description": "pi extension for shipmates: let pi sessions see, message and ask each other, and raise questions to the human's inbox",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/shipmates.git",
		"directory": "packages/shipmates-pi"
	},
	"keywords": [
		"pi-package",
		"pi",
		"coding-agent",
		"sessions",
		"messaging",
		"coordination"
	],
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"skills"
	],
	"engines": {
		"node": ">=22.5.0"
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		],
		"skills": [
			"./skills"
		]
	},
	"dependencies": {
		"shipmates": "workspace:*"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "~1.4.0",
		"@earendil-works/pi-coding-agent": "~1.4.0",
		"@types/node": "^25.2.0",
		"typebox": "1.3.27",
		"typescript": "^5.3.3",
		"vitest": "^4.0.18"
	},
	"scripts": {
		"build": "rm -rf skills && cp -r ../../skills ./skills && tsc",
		"test": "pnpm --filter shipmates build && vitest run",
		"test:watch": "vitest"
	}
}
